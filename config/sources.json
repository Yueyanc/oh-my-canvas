{
  "rules": {
    "keywords": [
      "ai",
      "agent",
      "open source",
      "typescript",
      "bun",
      "sqlite"
    ],
    "blocklist": [
      "sponsored",
      "giveaway"
    ],
    "sourceWeights": {
      "hackernews": 6
    }
  },
  "sources": [
    {
      "id": "hn-top",
      "type": "hackernews",
      "name": "Hacker News Top Stories",
      "enabled": true,
      "feed": "topstories",
      "limit": 100,
      "comments": {
        "enabled": true,
        "maxTopLevel": 8,
        "maxDepth": 2,
        "maxTotal": 40
      },
      "weight": 8
    },
    {
      "id": "hn-best",
      "type": "hackernews",
      "name": "Hacker News Best Stories",
      "enabled": true,
      "feed": "beststories",
      "limit": 150,
      "comments": {
        "enabled": true,
        "maxTopLevel": 8,
        "maxDepth": 2,
        "maxTotal": 40
      },
      "weight": 8
    },
    {
      "id": "github-trending-daily",
      "type": "github",
      "name": "GitHub Trending Daily",
      "enabled": true,
      "schedule": "github-daily",
      "query": "trending",
      "since": "daily",
      "limit": 50,
      "weight": 7
    },
    {
      "id": "github-trending-weekly",
      "type": "github",
      "name": "GitHub Trending Weekly",
      "enabled": true,
      "schedule": "github-weekly",
      "query": "trending",
      "since": "weekly",
      "limit": 50,
      "weight": 7
    }
  ]
}
