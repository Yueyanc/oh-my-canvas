DATABASE_URL=file:data/radar.sqlite
OPENAI_API_KEY=
OPENAI_BASE_URL=https://s2a.yueyanc.cn/v1
OPENAI_MODEL=gpt-5.4-mini
AI_QUALITY_ENABLED=true
AI_QUALITY_MAX_PER_RUN=30
AI_DISCUSSION_ENABLED=true
AI_DISCUSSION_MAX_PER_RUN=8
AI_DISCUSSION_MAX_COMMENTS=30
AI_READING_ENABLED=true
AI_READING_MAX_PER_RUN=8
AI_READING_MAX_CHARS=12000
AI_REPO_BRIEF_ENABLED=true
AI_REPO_BRIEF_MAX_PER_RUN=12
AI_REPO_BRIEF_README_MAX_CHARS=14000
ARTICLE_MIN_CHARS=800
ARTICLE_STATIC_TIMEOUT_MS=8000
ARTICLE_BROWSER_FALLBACK_ENABLED=true
ARTICLE_BROWSER_TIMEOUT_MS=18000
OPENROUTER_API_KEY=
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
PORT=8787
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
AUTO_COLLECT_ENABLED=true
AUTO_COLLECT_INTERVAL_MS=43200000
GITHUB_TRENDING_DAILY_ENABLED=true
GITHUB_TRENDING_WEEKLY_ENABLED=true
AI_CLASSIFY_MAX_PER_RUN=120
AI_CLASSIFY_MIN_SCORE=0
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
